{
    "city": "{{ city }}",
    "country": "{{ country }}",
    "measurements": [
        {% for measurement in measurements %}
        {
            "date": "{{ measurement.date | date('Y-m-d') | raw }}",
            "celsius": "{{ measurement.temperature }}",
            "precipitation": "{{ measurement.precipitation }}",
            "wind": "{{ measurement.wind }}",
            "humidity": "{{ measurement.humidity }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}

